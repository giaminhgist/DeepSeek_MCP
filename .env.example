# DeepSeek Worker environment — documentation template only.
# Copy these lines into your shell profile or MCP server env.
# Never commit real values.

# Required for deepseek_task / deepseek_review. deepseek_usage works without it.
DEEPSEEK_API_KEY=

# Optional: override the API base URL (e.g. compatible gateway). Defaults to the
# value in config/deepseek-worker.yaml.
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# Optional: absolute path to a custom worker YAML config.
# Defaults to <cwd>/config/deepseek-worker.yaml (searched upward).
DEEPSEEK_CONFIG=/absolute/path/to/DeepSeek_MCP/config/deepseek-worker.yaml

# Optional: repository root the worker may inspect.
# Defaults to the MCP process working directory.
DEEPSEEK_REPO_ROOT=/absolute/path/to/your/repository
